# Podcast Recall: frozen Week 4 quality configuration (frozen 2026-11-25)
#
# Use for held-out look 1 and the three gate runs. Works in zsh and bash:
#     source evals/frozen_config.env
# Runbook: specs/features/week4-hillclimb/gate-runbook.md
# Evidence for every line: specs/features/week4-hillclimb/results.md (experiment ids E1 to E11).
#
# Any change to this file, to the code, to the prompt or to the models after the freeze
# starts the count of gate runs again (see the runbook).
#
# Settings that are off are written as explicit 0 values, not left unset, so that a value
# exported earlier in the same shell cannot switch them back on.

# Answer model. E8: qwen2.5:14b-instruct fixed all four "refused with the gold passage shown"
# targets that five 7B experiments (E1, E2, E4, E5a, E7) could not; 17/20 on the E8 subset and
# 35/40 on the full 14B dev run (answers_dev_20261124-0613). Not the shipped default (7B) because
# of speed; this file is the quality configuration only.
export PODCAST_RECALL_ANSWER_MODEL=qwen2.5:14b-instruct

# Opening-minutes weight. E6: 0.5 fixed two retrieval misses (sf03, sf07) and raised R7 from 35%
# to 50% on dev; kept provisionally, to be confirmed at held-out look 1.
export PODCAST_RECALL_INTRO_WEIGHT=0.5

# Passages shown to the model. 4 is the setting of every adopted run (E6, E8, full 14B dev run).
# E7 (8 passages with 14 best units) was worse (24/40 against 28/40) and was reverted.
export PODCAST_RECALL_PASSAGES=4

# Model timeout in seconds. The 14B model is slow: E8 median 137 s, p90 214 s; the full 14B dev
# run had answered questions taking 110 to 270 s. The 120 s default would cut off normal answers.
# 600 s leaves headroom on a slow or warm machine (allowed range 5 to 900).
export PODCAST_RECALL_ANSWER_TIMEOUT_S=600

# No second-model answer check. E4: the checker dropped 70 of 74 claims and regressed 5 controls;
# the judge models failed calibration (68% and 80% agreement against the 85% bar, kappa 0.19 and
# 0.24 against 0.6), so nothing may filter answers on the judge's word.
export PODCAST_RECALL_ANSWER_CHECK=0

# No false-premise step. E9: fixed the 3 false-premise targets but turned 3 unanswerable
# controls (n14, p14, un01) into confident wrong corrections; that would also fail the D22
# release gate (an unanswerable question answered). Not adopted.
export PODCAST_RECALL_PREMISE_STEP=0

# Unit selection off (every unit of the 4 passages is shown). E5a: no gain with the 7B model;
# E7: refusals doubled; E11 (14B, 12 units): twice as fast but two answerable questions became
# not_found. Stays opt-in for the fast mode below, never for gate runs.
export PODCAST_RECALL_UNIT_TOP=0

# Answer prompt: the Week 3 prompt plus the E12 rule (rule 4 also answers not_found when the
# question is about one specific named subject that no passage mentions). It is code, not an
# environment variable. E1 (rules and worked examples) and E10 (claim-writing rules) were reverted;
# E12 was kept (results.md). prompting.py has
# sha256 607953cd0a3410c8c6772dc38fa26ee5323ab240385897861728d2ac13d09f58
# (the runbook checks this before every run). Frozen version 2 (2026-11-25), tag week4-frozen-v2.

# Judge model: not used for gating. It is only read by the answer check (off above) and by
# `eval judge-agreement`; R3 and R4 are graded by hand on the gate runs (judge agreement results
# in results.md; D20 Q8, D22). Deliberately not set here.

# Settings left at their code defaults, pinned so a stray export cannot change them. Changing
# either chunk value also makes the next `index build` redo every episode (D17).
export PODCAST_RECALL_EMBED_MODEL=nomic-embed-text
export PODCAST_RECALL_CHUNK_SECONDS=120
export PODCAST_RECALL_CHUNK_OVERLAP_SECONDS=24

# ---------------------------------------------------------------------------------------------
# FAST MODE: NOT FOR GATE RUNS, NOT FOR HELD-OUT LOOKS.
# E11 (14B, 12 best units): median 74.9 s instead of 148.7 s, but 18/20 instead of 20/20 on the
# same ids (sf03 and ww01 became not_found) and R7 3/8. For trying things by hand only.
# To use it, uncomment the line below in a copy of this file, never in this file.
# export PODCAST_RECALL_UNIT_TOP=12
# ---------------------------------------------------------------------------------------------
